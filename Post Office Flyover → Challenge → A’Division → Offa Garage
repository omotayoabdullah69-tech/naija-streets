function building(
    x,
    z,
    w,
    d,
    h,
    color,
    sign
){

    const b =
        box(
            w,
            h,
            d,
            x,
            h/2,
            z,
            material(color)
        );

    // roof
    box(
        w+.5,
        .35,
        d+.5,
        x,
        h+.2,
        z,
        concrete
    );

    // front facade
    const front =
        z<0
        ? z-d/2-.08
        : z+d/2+.08;

    // windows
    const count=
        Math.max(
            2,
            Math.floor(w/7)
        );

    for(
        let i=0;
        i<count;
        i++
    ){

        const wx=
            x-w/2+3.5+
            i*((w-7)/(count-1||1));

        box(
            2.2,
            2.3,
            .12,
            wx,
            Math.min(
                h-3,
                Math.max(3,h*.55)
            ),
            front,
            material(0x79aabd)
        );
    }

    // shop sign
    if(sign){

        box(
            Math.min(
                w*.78,
                19
            ),
            1.7,
            .16,
            x,
            Math.min(h-1.4,7),
            front-.1,
            material(0xf2df9d)
        );
    }

    return b;
}


