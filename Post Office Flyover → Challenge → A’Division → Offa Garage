// ============================================================
// JOYSTICK
// ============================================================

const joystick=
    document.getElementById(
        "joystick"
    );

const stick=
    document.getElementById(
        "stick"
    );

let joyX=0;
let joyY=0;
let active=false;

function moveJoystick(
    x,
    y
){

    const r=
        joystick.getBoundingClientRect();

    const cx=
        r.left+r.width/2;

    const cy=
        r.top+r.height/2;

    let dx=x-cx;
    let dy=y-cy;

    const max=45;

    const len=
        Math.sqrt(
            dx*dx+dy*dy
        );

    if(len>max){

        dx=
            dx/len*max;

        dy=
            dy/len*max;
    }

    joyX=dx/max;
    joyY=dy/max;

    stick.style.transform=
        `translate(${dx}px,${dy}px)`;
}

function resetJoystick(){

    active=false;
    joyX=0;
    joyY=0;

    stick.style.transform=
        "translate(0,0)";
}

joystick.addEventListener(
    "pointerdown",
    e=>{

        active=true;

        joystick.setPointerCapture(
            e.pointerId
        );

        moveJoystick(
            e.clientX,
            e.clientY
        );
    }
);

joystick.addEventListener(
    "pointermove",
    e=>{

        if(active){

            moveJoystick(
                e.clientX,
                e.clientY
            );
        }
    }
);

joystick.addEventListener(
    "pointerup",
    resetJoystick
);

joystick.addEventListener(
    "pointercancel",
    resetJoystick
);


// ============================================================
// FLYOVER HEIGHT
// ============================================================

function flyoverHeight(
    z,
    center
){

    const distance=
        Math.abs(z-center);

    // flat top
    if(distance<=46)
        return 9;

    // approach / descent
    if(distance<=88){

        return 9-
            (
                (distance-46)/42
            )*9;
    }

    return 0;
}

function roadHeight(z){

    return Math.max(
        flyoverHeight(z,-5),
        flyoverHeight(z,255)
    );
}


// ============================================================
// VEHICLE IN-FRONT DETECTION
// ============================================================

function vehicleIsFacingPlayer(v){

    const carPos=
        new THREE.Vector3();

    v.g.getWorldPosition(carPos);

    const difference=
        player.position
        .clone()
        .sub(carPos);

    difference.y=0;

    const distance=
        difference.length();

    if(distance>11)
        return false;

    difference.normalize();

    const forward=
        new THREE.Vector3(
            0,
            0,
            v.direction>0?1:-1
        );

    return forward.dot(difference)>.58;
}


// ============================================================
// LOCATION
// ============================================================

const location=
    document.getElementById(
        "location"
    );

function updateLocation(){

    const z=player.position.z;

    let text="Post Office";

    if(z>-30 && z<100)
        text="Post Office / Challenge";

    else if(z>=100 && z<220)
        text="Challenge Commercial Area";

    else if(z>=220 && z<310)
        text="A-Division Police Station";

    else if(z>=310 && z<470)
        text="A-Division / Offa Garage";

    else if(z>=470 && z<620)
        text="Offa Garage Corridor";

    else if(z>=620)
        text="Olunlade";

    location.textContent=
        "Location: "+text;
}


// ============================================================
// CLOUDS
// ============================================================

const clouds=[];

function createCloud(
    x,y,z
){

    const g=
        new THREE.Group();

    for(
        let i=0;
        i<5;
        i++
    ){

        const c=
            new THREE.Mesh(
                new THREE.SphereGeometry(
                    6+Math.random()*3,
                    12,
                    10
                ),
                new THREE.MeshStandardMaterial({
                    color:0xffffff,
                    transparent:true,
                    opacity:.82
                })
            );

        c.position.set(
            i*6-12,
            Math.random()*2,
            Math.random()*5
        );

        g.add(c);
    }

    g.position.set(
        x,y,z
    );

    scene.add(g);

    clouds.push(g);
}

createCloud(-120,95,-180);
createCloud(100,115,20);
createCloud(-160,120,300);
createCloud(120,105,520);


// ============================================================
// RAIN
// ============================================================

const RAIN_COUNT=850;

const rainPositions=
    new Float32Array(
        RAIN_COUNT*3
    );

for(
    let i=0;
    i<RAIN_COUNT;
    i++
){

    rainPositions[i*3]=
        (Math.random()-.5)*600;

    rainPositions[i*3+1]=
        Math.random()*140;

    rainPositions[i*3+2]=
        (Math.random()-.5)*1000;
}

const rainGeometry=
    new THREE.BufferGeometry();

rainGeometry.setAttribute(
    "position",
    new THREE.BufferAttribute(
        rainPositions,
        3
    )
);

const rainMaterial=
    new THREE.PointsMaterial({
        color:0xb9dcff,
        size:.6,
        transparent:true,
        opacity:.42
    });

const rain=
    new THREE.Points(
        rainGeometry,
        rainMaterial
    );

scene.add(rain);


// ============================================================
// CAMERA
// ============================================================

const target=
    new THREE.Vector3();

function updateCamera(){

    const offset=
        new THREE.Vector3(
            0,
            7.5,
            12.5
        );

    offset.applyAxisAngle(
        new THREE.Vector3(0,1,0),
        player.rotation.y
    );

    const desired=
        player.position
        .clone()
        .add(offset);

    // NEVER allow camera below road
    const floor=
        roadHeight(
            player.position.z
        );

    desired.y=
        Math.max(
            desired.y,
            floor+5
        );

    camera.position.lerp(
        desired,
        .09
    );

    target.copy(
        player.position
    );

    target.y+=2;

    camera.lookAt(target);
}


// ============================================================
// GAME LOOP
// ============================================================

let previous=
    performance.now();

function animate(now){

    requestAnimationFrame(
        animate
    );

    const dt=
        Math.min(
            (now-previous)/16.67,
            2
        );

    previous=now;


    // --------------------------------------------------------
    // PLAYER TURN
    // --------------------------------------------------------

    player.rotation.y
        -=
        joyX*
        .055*
        dt;


    // --------------------------------------------------------
    // PLAYER MOVEMENT
    // --------------------------------------------------------

    const forward=
        new THREE.Vector3(
            0,
            0,
            1
        );

    forward.applyAxisAngle(
        new THREE.Vector3(0,1,0),
        player.rotation.y
    );

    player.position.addScaledVector(
        forward,
        -joyY*
        .23*
        dt
    );


    // world boundaries
    player.position.x=
        THREE.MathUtils.clamp(
            player.position.x,
            -125,
            125
        );

    player.position.z=
        THREE.MathUtils.clamp(
            player.position.z,
            -450,
            750
        );


    // flyover height
    player.position.y=
        roadHeight(
            player.position.z
        );


    // --------------------------------------------------------
    // VEHICLES
    // --------------------------------------------------------

    for(
        const v of vehicles
    ){

        const stop=
            vehicleIsFacingPlayer(v);

        v.stopped=stop;

        if(stop){

            // flashing headlights
            for(
                const light of
                v.headlights
            ){

                light.material
                    .emissiveIntensity=
                    .75+
                    Math.sin(
                        now*.012
                    )*.35;
            }

            v.glow.intensity=
                1.8+
                Math.sin(
                    now*.012
                )*.7;

        }else{

            for(
                const light of
                v.headlights
            ){

                light.material
                    .emissiveIntensity=.15;
            }

            v.glow.intensity=0;

            v.g.position.z+=
                v.direction*
                v.speed*
                dt;

            if(
                v.g.position.z>770
            )
                v.g.position.z=-460;

            if(
                v.g.position.z<-460
            )
                v.g.position.z=770;
        }

        v.g.position.y=
            roadHeight(
                v.g.position.z
            );
    }


    // --------------------------------------------------------
    // PEOPLE
    // --------------------------------------------------------

    for(
        const p of people
    ){

        p.g.position.z+=
            p.dir*
            p.speed*
            dt;

        if(
            p.g.position.z>750
        )
            p.g.position.z=-440;

        if(
            p.g.position.z<-440
        )
            p.g.position.z=750;

        p.g.position.y=
            roadHeight(
                p.g.position.z
            );
    }


    // --------------------------------------------------------
    // RAIN
    // --------------------------------------------------------

    const rp=
        rainGeometry
        .attributes
        .position
        .array;

    for(
        let i=0;
        i<RAIN_COUNT;
        i++
    ){

        rp[i*3+1]-=
            1.25*dt;

        if(
            rp[i*3+1]<0
        )
            rp[i*3+1]=140;
    }

    rainGeometry
        .attributes
        .position
        .needsUpdate=true;


    // --------------------------------------------------------
    // CLOUDS
    // --------------------------------------------------------

    for(
        const c of clouds
    ){

        c.position.x+=
            .008*dt;

        if(c.position.x>300)
            c.position.x=-300;
    }


    updateLocation();
    updateCamera();

    renderer.render(
        scene,
        camera
    );
}

animate(
    performance.now()
);


// ============================================================
// RESIZE
// ============================================================

addEventListener(
    "resize",
    ()=>{

        camera.aspect=
            innerWidth/
            innerHeight;

        camera.updateProjectionMatrix();

        renderer.setSize(
            innerWidth,
            innerHeight
        );
    }
);


