const vehicles=[];

function createVehicle(
    x,
    z,
    color,
    direction,
    bus=false
){

    const g=
        new THREE.Group();

    const body=
        new THREE.Mesh(
            new THREE.BoxGeometry(
                bus?4.8:3.4,
                bus?2.8:1.5,
                bus?10:6,
            ),
            material(color)
        );

    body.position.y=
        bus?2.1:1.25;

    body.castShadow=true;

    g.add(body);

    if(!bus){

        const roof=
            new THREE.Mesh(
                new THREE.BoxGeometry(
                    2.6,
                    .9,
                    3
                ),
                material(color)
            );

        roof.position.y=2.25;

        g.add(roof);
    }

    // wheels
    for(
        const px of [-1.65,1.65]
    ){

        for(
            const pz of [-2,2]
        ){

            const wheel=
                new THREE.Mesh(
                    new THREE.CylinderGeometry(
                        .6,.6,.5,12
                    ),
                    black
                );

            wheel.rotation.z=
                Math.PI/2;

            wheel.position.set(
                px,
                .65,
                pz
            );

            g.add(wheel);
        }
    }

    // headlights
    const headlights=[];

    for(
        const px of [-.95,.95]
    ){

        const light=
            new THREE.Mesh(
                new THREE.BoxGeometry(
                    .42,
                    .28,
                    .12
                ),
                new THREE.MeshStandardMaterial({
                    color:0xffffcc,
                    emissive:0xffff99,
                    emissiveIntensity:.2
                })
            );

        light.position.set(
            px,
            1.45,
            direction>0?-3.05:3.05
        );

        g.add(light);

        headlights.push(light);
    }

    // actual headlight glow
    const glow=
        new THREE.PointLight(
            0xfff0b0,
            0,
            14
        );

    glow.position.set(
        0,
        1.4,
        direction>0?-3:3
    );

    g.add(glow);

    g.position.set(
        x,
        0,
        z
    );

    if(direction<0)
        g.rotation.y=Math.PI;

    scene.add(g);

    vehicles.push({
        g,
        direction,
        speed:
            bus
            ?.105
            :.15+Math.random()*.08,
        headlights,
        glow,
        stopped:false
    });
}


