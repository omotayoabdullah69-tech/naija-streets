function createFlyover(
    centerZ
){

    const width=23;

    const deckLength=92;

    // deck
    box(
        width,
        1.7,
        deckLength,
        0,
        9,
        centerZ,
        concrete
    );

    // deck surface
    box(
        width-1,
        .12,
        deckLength-2,
        0,
        9.92,
        centerZ,
        road,
        false
    );

    // barriers
    box(
        1,
        1.8,
        deckLength,
        -width/2,
        10,
        centerZ,
        concrete
    );

    box(
        1,
        1.8,
        deckLength,
        width/2,
        10,
        centerZ,
        concrete
    );

    // supports
    for(
        let z=centerZ-34;
        z<=centerZ+34;
        z+=17
    ){

        box(
            1.7,
            9,
            1.7,
            -7,
            4.5,
            z,
            concrete
        );

        box(
            1.7,
            9,
            1.7,
            7,
            4.5,
            z,
            concrete
        );
    }

    // ramps
    const rampLength=42;

    const angle=
        Math.atan2(
            9,
            rampLength
        );

    const ramp1=
        box(
            width,
            1.5,
            rampLength,
            0,
            4.5,
            centerZ-67,
            concrete
        );

    ramp1.rotation.x=angle;

    const ramp2=
        box(
            width,
            1.5,
            rampLength,
            0,
            4.5,
            centerZ+67,
            concrete
        );

    ramp2.rotation.x=-angle;

    // ramp barriers
    for(
        const side of [-1,1]
    ){

        const a=
            box(
                1,
                1.7,
                rampLength,
                side*(width/2),
                5,
                centerZ-67,
                concrete
            );

        a.rotation.x=angle;

        const b=
            box(
                1,
                1.7,
                rampLength,
                side*(width/2),
                5,
                centerZ+67,
                concrete
            );

        b.rotation.x=-angle;
    }
}


