    if(z>=470)
        name="Olunlade";

    locationText.textContent=
        "Location: "+name;

}


// =====================================================
// CLOUDS
// =====================================================

const clouds=[];

function cloud(x,y,z){

    const g=new THREE.Group();

    for(let i=0;i<5;i++){

        const c=new THREE.Mesh(
            new THREE.SphereGeometry(
                6+Math.random()*4,
                12,
                10
            ),
            new THREE.MeshStandardMaterial({
                color:0xffffff,
                transparent:true,
                opacity:.85
            })
        );

        c.position.set(
            i*6-12,
            Math.random()*2,
            Math.random()*5
        );

        g.add(c);

    }

    g.position.set(x,y,z);

    scene.add(g);

    clouds.push(g);

}

cloud(-100,90,-150);
cloud(130,110,50);
cloud(-160,120,300);
cloud(100,100,500);


// =====================================================
// RAIN
// =====================================================

const rainCount=900;

const rainPositions=
new Float32Array(rainCount*3);

for(let i=0;i<rainCount;i++){

    rainPositions[i*3]=
        (Math.random()-.5)*500;

    rainPositions[i*3+1]=
        Math.random()*130;

    rainPositions[i*3+2]=
        (Math.random()-.5)*900;

}

const rainGeometry=
new THREE.BufferGeometry();

rainGeometry.setAttribute(
    "position",
    new THREE.BufferAttribute(
        rainPositions,
        3
    )
);

const rainMaterial=
new THREE.PointsMaterial({
    color:0xb8d8ff,
    size:.65,
    transparent:true,
    opacity:.45
});

const rain=
new THREE.Points(
    rainGeometry,
    rainMaterial
);

scene.add(rain);


// =====================================================
// CAMERA
// =====================================================

const cameraTarget=
new THREE.Vector3();

function updateCamera(){

    const behind=
        new THREE.Vector3(
            0,
            8,
            13
        );

    behind.applyAxisAngle(
        new THREE.Vector3(0,1,0),
        player.rotation.y
    );

    const desired=
        player.position
        .clone()
        .add(behind);

    const ground=
        getRoadHeight(
            player.position.z
        );

    desired.y=
        Math.max(
            desired.y,
            ground+5
        );

    camera.position.lerp(
        desired,
        .09
    );

    cameraTarget.copy(
        player.position
    );

    cameraTarget.y+=2.2;

    camera.lookAt(cameraTarget);

}


// =====================================================
// GAME LOOP
// =====================================================

let last=performance.now();

function animate(now){

    requestAnimationFrame(animate);

    const dt=
        Math.min(
            (now-last)/16.67,
            2
        );

    last=now;


    // ================================================
    // PLAYER
    // ================================================

    const turnSpeed=.055;

    player.rotation.y
        -= joyX*turnSpeed*dt;

    const moveSpeed=.22;

    const forward=
        new THREE.Vector3(
            0,
            0,
            1
        );

    forward.applyAxisAngle(
        new THREE.Vector3(0,1,0),
        player.rotation.y
    );

    player.position.addScaledVector(
        forward,
        -joyY*moveSpeed*dt
    );


    // keep player in world
    player.position.x=
        THREE.MathUtils.clamp(
            player.position.x,
            -120,
            120
        );

    player.position.z=
        THREE.MathUtils.clamp(
            player.position.z,
            -430,
            730
        );


    // flyover height
    player.position.y=
        getRoadHeight(
            player.position.z
        );


    // ================================================
    // VEHICLES
    // ================================================

    for(const v of vehicles){

        const stop=
            vehicleInFront(v);

        v.stopped=stop;

        if(stop){

            for(const light of v.lights){

                light.material.emissiveIntensity=
                    .9+Math.sin(now*.012)*.5;

            }

        }else{

            for(const light of v.lights){

                light.material.emissiveIntensity=.2;

            }

            v.group.position.z+=
                v.direction*
                v.speed*
                dt;

            if(v.group.position.z>760)
                v.group.position.z=-450;

            if(v.group.position.z<-450)
                v.group.position.z=760;

        }

        v.group.position.y=
            getRoadHeight(
                v.group.position.z
            );

    }


    // ================================================
    // PEOPLE
    // ================================================

    for(const p of people){

        p.g.position.z+=
            p.dir*p.speed*dt;

        if(p.g.position.z>720)
            p.g.position.z=-420;

        if(p.g.position.z<-420)
            p.g.position.z=720;

        p.g.position.y=
            getRoadHeight(
                p.g.position.z
            );

    }


    // ================================================
    // RAIN
    // ================================================

    const pos=
        rain.geometry.attributes.position.array;

    for(let i=0;i<rainCount;i++){

        pos[i*3+1]-=
            1.2*dt;

        if(pos[i*3+1]<0){

            pos[i*3+1]=130;

        }

    }

    rain.geometry.attributes.position.needsUpdate=true;


    // ================================================
    // CLOUD MOVEMENT
    // ================================================

    for(const c of clouds){

        c.position.x+=
            .008*dt;

        if(c.position.x>260)
            c.position.x=-260;

    }


    updateLocation();
    updateCamera();

    renderer.render(
        scene,
        camera
    );

}

animate(performance.now());


// =====================================================
// RESIZE
// =====================================================

addEventListener(
    "resize",
    ()=>{

        camera.aspect=
            innerWidth/innerHeight;

        camera.updateProjectionMatrix();

        renderer.setSize(
            innerWidth,
            innerHeight
        );

    }
);


// =====================================================
// START
// =====================================================

document.getElementById(
    "loading"
).style.display="none";

</script>

