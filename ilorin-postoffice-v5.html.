function box(
    w,h,d,
    x,y,z,
    material,
    cast=true
){

    const g = new THREE.BoxGeometry(w,h,d);

    const m = new THREE.Mesh(g,material);

    m.position.set(x,y,z);

    m.castShadow = cast;
    m.receiveShadow = true;

    scene.add(m);

    return m;
}


function cylinder(
    radius,
    height,
    x,y,z,
    material
){

    const g = new THREE.CylinderGeometry(
        radius,
        radius,
        height,
        16
    );

    const m = new THREE.Mesh(g,material);

    m.position.set(x,y,z);

    m.castShadow=true;
    m.receiveShadow=true;

    scene.add(m);

    return m;
}


