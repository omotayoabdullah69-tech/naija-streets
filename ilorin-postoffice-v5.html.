const vehicles=[];

function makeCar(
    x,z,color,
    direction=1,
    type="car"
){

    const group=new THREE.Group();

    const body=new THREE.Mesh(
        new THREE.BoxGeometry(
            type==="bus"?4.8:3.5,
            type==="bus"?2.8:1.5,
            type==="bus"?11:6,
        ),
        mat(color)
    );

    body.position.y=
        type==="bus"?2.2:1.4;

    body.castShadow=true;

    group.add(body);

    // roof
    if(type==="car"){

        const roof=new THREE.Mesh(
            new THREE.BoxGeometry(2.8,1,3),
            mat(color)
        );

        roof.position.y=2.5;

        group.add(roof);

    }

    // wheels
    const wheelPositions=[
        [-1.7,1,-2],
        [1.7,1,-2],
        [-1.7,1,2],
        [1.7,1,2]
    ];

    for(const p of wheelPositions){

        const wheel=new THREE.Mesh(
            new THREE.CylinderGeometry(
                .65,.65,.5,12
            ),
            blackMat
        );

        wheel.rotation.z=Math.PI/2;

        wheel.position.set(
            p[0],
            .75,
            p[2]
        );

        group.add(wheel);

    }

    // headlights
    const lights=[];

    for(const side of [-1,1]){

        const light=new THREE.Mesh(
            new THREE.BoxGeometry(
                .45,.3,.12
            ),
            new THREE.MeshStandardMaterial({
                color:0xffffcc,
                emissive:0xffffaa,
                emissiveIntensity:.2
            })
        );

        light.position.set(
            side*.95,
            1.5,
            direction>0?-3.03:3.03
        );

        group.add(light);

        lights.push(light);

    }

    group.position.set(
        x,
        0,
        z
    );

    if(direction<0){
        group.rotation.y=Math.PI;
    }

    scene.add(group);

    vehicles.push({
        group,
        direction,
        speed:.16+Math.random()*.08,
        lights,
        stopped:false
    });

}

