        x,
        h+.18,
        z,
        concreteMat
    );

    // front windows
    const frontZ =
        z > 0 ? z-d/2-.02 : z+d/2+.02;

    const windowCount =
        Math.max(2,Math.floor(w/8));

    for(let i=0;i<windowCount;i++){

